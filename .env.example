# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RUANG PROYEK ENVIRONMENT CONFIGURATION
DATABASE_URL="postgres://postgres:password@localhost:5432/ruangproyek"
JWT_SECRET="super-secure-jwt-secret-key"

# PAYMENT GATEWAYS (Midtrans / Xendit / Tripay / Duitku)
PAYMENT_GATEWAY_PROVIDER="midtrans" # midtrans | xendit | tripay | duitku | sandbox
PAYMENT_SERVER_KEY="SB-Mid-server-xxxx"
PAYMENT_CLIENT_KEY="SB-Mid-client-xxxx"
PAYMENT_WEBHOOK_SECRET="webhook_secret_signature_key_xxxx"

# EMAIL NOTIFICATION (SMTP / Resend / SendGrid)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASSWORD="smtp_password"
EMAIL_FROM_NAME="Ruang Proyek"
EMAIL_FROM_ADDRESS="no-reply@ruangproyek.com"

# WHATSAPP INTEGRATION (Fonnte / Waha / Wablas)
WHATSAPP_PROVIDER="fonnte"
WHATSAPP_API_KEY="fonnte_token_xxxx"
WHATSAPP_SENDER_NUMBER="6281234567890"

# TELEGRAM BOT INTEGRATION
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
TELEGRAM_ADMIN_CHAT_ID="987654321"

# SECURE CLOUD STORAGE (S3 / Cloud Storage / Cloudflare R2)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="ruangproyek-private-assets"
STORAGE_REGION="ap-southeast-1"
STORAGE_ACCESS_KEY="AKIAXXXXXXXXXXXXXXXX"
STORAGE_SECRET_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
